# Block direct access to credential/data files and dotfiles (security fix)
<FilesMatch "^(settings\.json|orders\.json|employees\.json|error_log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Gzip/Deflate compression for all servers
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml font/ttf font/woff font/woff2
    DeflateCompressionLevel 6
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Explicit Cache-Control (belt-and-braces alongside mod_expires above —
# some proxies/CDNs only honor Cache-Control, not Expires)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|png|jpe?g|svg|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule LiteSpeed>
    # Enable the cache engine
    CacheEnable public
    RewriteEngine On

    # EXCLUSIONS (CRITICAL)
    # Never cache the Admin panel, cart, checkout forms, or payment processors
    RewriteCond %{REQUEST_URI} ^/admin/ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/cart\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/checkout\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/process_checkout\.php [NC,OR]
    RewriteCond %{REQUEST_URI} ^/checkout_success\.php [NC]
    RewriteRule .* - [E=Cache-Control:no-cache,L]

    # INCLUSIONS
    # Cache all other standard GET requests (like index, product details, category) for 10 minutes (600 seconds)
    RewriteCond %{REQUEST_METHOD} ^GET|HEAD$
    RewriteRule .* - [E=Cache-Control:max-age=600]
</IfModule>
